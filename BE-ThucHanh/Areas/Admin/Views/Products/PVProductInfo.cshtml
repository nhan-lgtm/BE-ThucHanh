@model BE_ThucHanh.Models.Product

<head>
    <style>
        .col-md-4 img {
            width: 100%;
            max-width: 250px;
            height: auto;
            display: block;
            margin: 0 auto;
        }
    </style>
</head>


<div class="container-fluid">
    <div class="row">
        <div class="col-md-4">
            <img src="@Html.DisplayFor(model => model.ProductImage)" />
        </div>
        <div class="col-md-8">
            <dl class="dl-horizontal">
                <dl>
                    <dt>Tên sản phẩm</dt>
                    <dd>@Html.DisplayFor(model => model.ProductName)</dd>

                    <dt>Đơn giá</dt>
                    <dd>@Html.DisplayFor(model => model.ProductPrice)</dd>

                    <dt>Mô tả</dt>
                    <dd>@Html.DisplayFor(model => model.ProductDescription)</dd>

                    <dt>Danh mục</dt>
                    <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
                </dl>
            </dl>
        </div>
    </div>
</div>
