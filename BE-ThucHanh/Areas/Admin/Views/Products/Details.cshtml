@model BE_ThucHanh.Models.Product

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_Adminlayout.cshtml";
}
<h2 class="bg-success">CHI TIẾT SẢN PHẨM</h2>

@Html.Partial("PVProductInfo", Model)

<div class="form-group">
    <div class="col-md-offset-4 col-md-8" style="margin-top: 15px;">
        @Html.ActionLink("Sửa", "Edit", new { id = Model.ProductID },
        new { @class = "btn btn-primary" })
        @Html.ActionLink("Quay lại danh sách", "Index", null,
        new { @class = "btn btn-primary" })
    </div>
</div>
