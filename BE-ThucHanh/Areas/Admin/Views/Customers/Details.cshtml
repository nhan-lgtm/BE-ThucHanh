@model BE_ThucHanh.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
}

<h2 class="mb-3">Chi tiết khách hàng</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4">
    <div class="card-header fw-bold">Thông tin tài khoản</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Mã khách hàng</dt>
            <dd class="col-sm-9">@Model.CustomerID</dd>

            <dt class="col-sm-3">Tên đăng nhập</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3">Họ tên</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>

            <dt class="col-sm-3">Số điện thoại</dt>
            <dd class="col-sm-9">@Model.CustomerPhone</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.CustomerEmail</dd>

            <dt class="col-sm-3">Địa chỉ</dt>
            <dd class="col-sm-9">@Model.CustomerAddress</dd>
        </dl>
    </div>
</div>

<h4>Đơn hàng của khách (@Model.Orders.Count)</h4>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Ngày đặt</th>
            <th>Trạng thái</th>
            <th class="text-end">Tổng tiền</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model.Orders.OrderByDescending(x => x.OrderDate))
        {
            <tr>
                <td>#@o.OrderID</td>
                <td>@string.Format("{0:dd/MM/yyyy HH:mm}", o.OrderDate)</td>
                <td>@o.PaymentStatus</td>
                <td class="text-end">@string.Format("{0:N0}", o.TotalAmount) đ</td>
                <td class="text-end">
                    <a href="@Url.Action("Details", "Orders", new { id = o.OrderID })" class="btn btn-sm btn-info">Xem</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a href="@Url.Action("Edit", new { id = Model.CustomerID })" class="btn btn-warning">Sửa thông tin</a>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại danh sách</a>

    @using (Html.BeginForm("Delete", "Customers", new { id = Model.CustomerID }, FormMethod.Post,
        new { @class = "d-inline", onsubmit = "return confirm('Xóa khách hàng và tài khoản này?');" }))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Xóa</button>
    }
</div>
