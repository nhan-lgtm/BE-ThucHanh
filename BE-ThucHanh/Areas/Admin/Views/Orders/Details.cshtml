@model BE_ThucHanh.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    var statuses = (string[])ViewBag.Statuses;
}

<h2 class="mb-3">Đơn hàng #@Model.OrderID</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <div class="col-md-7 mb-3">
        <div class="card h-100">
            <div class="card-header fw-bold">Thông tin đơn hàng</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Khách hàng</dt>
                    <dd class="col-sm-8">
                        <a href="@Url.Action("Details", "Customers", new { id = Model.CustomerID })">
                            @Model.Customer.CustomerName
                        </a>
                        <small class="text-muted">(@Model.Customer.Username)</small>
                    </dd>

                    <dt class="col-sm-4">Điện thoại</dt>
                    <dd class="col-sm-8">@Model.Customer.CustomerPhone</dd>

                    <dt class="col-sm-4">Ngày đặt</dt>
                    <dd class="col-sm-8">@string.Format("{0:dd/MM/yyyy HH:mm}", Model.OrderDate)</dd>

                    <dt class="col-sm-4">Địa chỉ giao</dt>
                    <dd class="col-sm-8">@Model.AddressDelivery</dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">@Model.PaymentStatus</dd>

                    <dt class="col-sm-4">Cập nhật lúc</dt>
                    <dd class="col-sm-8">@string.Format("{0:dd/MM/yyyy HH:mm}", Model.StatusUpdatedAt)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-5 mb-3">
        <div class="card h-100">
            <div class="card-header fw-bold">Cập nhật trạng thái</div>
            <div class="card-body">
                @using (Html.BeginForm("UpdateStatus", "Orders", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OrderID" />
                    <div class="mb-3">
                        <select name="status" class="form-select">
                            @foreach (var s in statuses)
                            {
                                <option value="@s" @(s == Model.PaymentStatus ? "selected" : "")>@s</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Cập nhật</button>
                }
            </div>
        </div>
    </div>
</div>

<h4>Sản phẩm trong đơn</h4>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th class="text-end">Đơn giá</th>
            <th class="text-center">SL</th>
            <th class="text-end">Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.OrderDetails)
        {
            <tr>
                <td>@d.Product.ProductName</td>
                <td class="text-end">@string.Format("{0:N0}", d.UnitPrice) đ</td>
                <td class="text-center">@d.Quantity</td>
                <td class="text-end">@string.Format("{0:N0}", d.UnitPrice * d.Quantity) đ</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Tổng cộng</th>
            <th class="text-end text-danger">@string.Format("{0:N0}", Model.TotalAmount) đ</th>
        </tr>
    </tfoot>
</table>

<a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại danh sách</a>
