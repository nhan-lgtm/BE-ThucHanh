@model BE_ThucHanh.Models.Order

@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="alert alert-success">
        <h4 class="alert-heading mb-1">Đặt hàng thành công!</h4>
        <p class="mb-0">Cảm ơn bạn đã mua hàng. Mã đơn hàng của bạn là <strong>#@Model.OrderID</strong>.</p>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-bold">Thông tin đơn hàng</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Ngày đặt</dt>
                <dd class="col-sm-9">@string.Format("{0:dd/MM/yyyy HH:mm}", Model.OrderDate)</dd>

                <dt class="col-sm-3">Địa chỉ giao hàng</dt>
                <dd class="col-sm-9">@Model.AddressDelivery</dd>

                <dt class="col-sm-3">Trạng thái</dt>
                <dd class="col-sm-9">@Model.PaymentStatus</dd>

                <dt class="col-sm-3">Tổng tiền</dt>
                <dd class="col-sm-9 text-danger fw-bold">@string.Format("{0:N0}", Model.TotalAmount) đ</dd>
            </dl>
        </div>
    </div>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th class="text-end">Đơn giá</th>
                <th class="text-center">SL</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.OrderDetails)
            {
                <tr>
                    <td>@d.Product.ProductName</td>
                    <td class="text-end">@string.Format("{0:N0}", d.UnitPrice) đ</td>
                    <td class="text-center">@d.Quantity</td>
                    <td class="text-end">@string.Format("{0:N0}", d.UnitPrice * d.Quantity) đ</td>
                </tr>
            }
        </tbody>
    </table>

    <a href="@Url.Action("MyOrder", "Order")" class="btn btn-primary">Xem đơn hàng của tôi</a>
    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
</div>
