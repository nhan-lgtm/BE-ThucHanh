@model BE_ThucHanh.Models.ViewModel.HomeProductVM

<link rel="stylesheet" type="text/css" href="~/Content/MyStyle/CustomerHome.css" />

<!-- Hiển thị danh sách sản phẩm-->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section class="container-fluid featureProd my-4">
        <h2>Sản phẩm nổi bật</h2>
        <div class="feature-container">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="fproduct-item">
                    <div class="product-img-box">
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage)" alt="@product.ProductName" class="product-img" />
                        </a>
                    </div>
                    <div class="product-info">
                        <p class="prodPrice">
                            @product.ProductPrice.ToString("N0") đ
                        </p>
                        <p class="prodName" title="@product.ProductName">
                            @Html.DisplayFor(modelItem => product.ProductName)
                        </p>
                        <p class="prodCate">
                            Thể loại: @Html.DisplayFor(modelItem => product.Category.CategoryName)
                        </p>
                        <p class="prodSale">
                            Đã bán: &nbsp; @Html.DisplayFor(modelItem => product.OrderDetails.Count)
                        </p>
                    </div>
                </div>
            }
        </div>
    </section>
}