@model BE_ThucHanh.Models.ViewModel.ProductDetailsVM

@{
    ViewBag.Title = "ProductDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <style>
        .pro {
            padding: 50px 10px 50px 10px;
            background-color: ghostwhite;
        }

        .pro-section {
            background-color: white;
            border: 1px groove #ffffff;
            border-radius: 10px;
            padding: 10px;
            height: 100%;
        }

            .pro-section img {
                max-height: 250px;
                max-width: 200px;
                padding: 5px;
            }

        .pro-price {
            font-weight: bolder;
            font-size: larger;
            color: red;
        }

        .pro-sale {
            font-weight: lighter;
        }
    </style>
</head>

<div class="container-fluid pro">
    @* Ba khối nằm ngang: ảnh | thông tin | số lượng + giỏ hàng *@
    <div class="row g-3">
        @* Khối bên trái *@
        <div class="col-md-3">
            <div class="pro-section">
                @* Ảnh sản phẩm *@
                <img src="@Url.Content(Model.product.ProductImage)" alt="@Model.product.ProductName" />
            </div>
        </div>

        @* Khối ở giữa *@
        <div class="col-md-6">
            <div class="pro-section">
                @* Phần thông tin sản phẩm *@
                <div>
                    <h4><strong>@Html.DisplayFor(model => model.product.ProductName)</strong></h4>
                    <p class="pro-sale">Đã bán:&nbsp;@Model.product.OrderDetails.Count</p>
                    <p class="pro-price">@Model.product.ProductPrice.ToString("C")</p>
                    <p>Tủ sách:&nbsp;@Model.product.Category.CategoryName</p>
                    <hr />
                    <h5><strong>Mô tả</strong></h5>
                    <p> @Model.product.ProductDescription </p>
                </div>
                <hr />

                @* khối Related Product *@
                <div>@Html.Partial("PVRelatedProduct", Model)</div>
            </div>
        </div>

        @* Khối bên phải *@
        <div class="col-md-3">
            <div class="pro-section">
                <div class="form-group">
                    @* Phần tạm tính *@
                    @using (Html.BeginForm("ProductDetails", "Home", FormMethod.Get))
                    {
                        @Html.Hidden("id", Model.product.ProductID)
                        <h4><strong>Số lượng</strong> </h4>
                        <p>@Html.TextBoxFor(model => model.quantity, new { @class = "form-control", @type = "number", @min = 1 })</p>
                        <p><button type="submit" class="btn btn-default">Cập nhật</button></p>

                        <h4><strong>Tạm tính</strong></h4>
                        <p id="estimatedValue">@Model.estimatedValue.ToString("N0")</p>

                        <p>
                            @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart", new { id = Model.product.ProductID, quantity = Model.quantity }, new { @class = "btn btn-info", id = "btnAddToCart" })
                        </p>
                    }
                    <hr />
                </div>

                @* Khối TopProduct *@
                <div>@Html.Partial("PVTopProduct", Model)</div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // Đơn giá của sản phẩm (lấy từ server)
        var unitPrice = @Model.product.ProductPrice.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var productId = @Model.product.ProductID;
        var addToCartBase = '@Url.Action("AddToCart", "Cart")';

        var qtyInput = document.getElementById('quantity');
        var estimated = document.getElementById('estimatedValue');
        var addBtn = document.getElementById('btnAddToCart');

        if (!qtyInput || !estimated) return;

        function update() {
            var qty = parseInt(qtyInput.value, 10);
            if (isNaN(qty) || qty < 1) qty = 1;

            // Tạm tính = đơn giá x số lượng
            estimated.textContent = (unitPrice * qty).toLocaleString('en-US', { maximumFractionDigits: 0 });

            // Nút thêm vào giỏ dùng đúng số lượng đang chọn
            if (addBtn) {
                addBtn.href = addToCartBase + '?id=' + productId + '&quantity=' + qty;
            }
        }

        qtyInput.addEventListener('input', update);
        qtyInput.addEventListener('change', update);
        update(); // chạy một lần khi tải trang
    })();
</script>
