@model BE_ThucHanh.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

<!-- Hiển thị danh sách sản phẩm mới -->
@if (Model.NewProduct != null && Model.NewProduct.Any())
{
    <section class="container-fluid listProduct">
        <h2>Sản phẩm mới</h2>
        <ul class="list-container">
            @foreach (var product in Model.NewProduct)
            {
                <li class="product-item">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage)" alt="@product.ProductName" />
                        </a>
                    </div>
                    <div>
                        <p class="prodPrice">@product.ProductPrice</p>
                        <p class="prodName">@product.ProductName</p>
                        <p class="prodSale">
                            Đã bán: &nbsp; @product.OrderDetails.Count
                        </p>
                    </div>
                </li>
            }
        </ul>
    </section>

    <!-- Hiển thị phân trang -->
    <div class="pagination-container">
        @Html.PagedListPager(Model.NewProduct, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
    </div>
}
else
{
    <p>Không tìm được sản phẩm nào phù hợp.</p>
}
